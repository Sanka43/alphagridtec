---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, categoryLabel, site, tools } from '../../data/site';

const filters = [
  { id: '', label: 'All' },
  ...categories.map((c) => ({ id: c.id, label: c.title })),
];
---

<BaseLayout
  title="Tools"
  description={`Browse free APK, IPA, jailbreak, and Windows tools from ${site.name}.`}
>
  <header class="page-hero" data-page-hero>
    <div class="container">
      <p class="eyebrow eyebrow--mono">// tools</p>
      <h1 data-tools-heading>All tools.</h1>
      <p class="lead">
        Free direct downloads — Android APKs, iOS IPAs, jailbreak utilities, and Windows EXE tools.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container-wide">
      <div class="tools-filters" role="tablist" aria-label="Filter by category" data-tools-filters>
        {
          filters.map((f) => (
            <button
              type="button"
              class="tools-filter"
              data-filter={f.id}
              role="tab"
              aria-selected="false"
            >
              {f.label}
            </button>
          ))
        }
      </div>

      <p class="tools-empty" data-tools-empty hidden>No tools in this category yet.</p>

      <div class="work-grid work-grid--page" data-tools-grid>
        {
          tools.map((tool) => (
            <a
              href={`/tools/${tool.slug}`}
              class="work-card work-card--detail"
              data-tool-card
              data-category={tool.category}
            >
              <div
                class:list={['work-card__media', tool.image && 'work-card__media--has-image']}
                style={tool.image ? `background-image: url(${tool.image})` : undefined}
              />
              <div class="work-card__meta">
                <div class="work-card__extra">
                  <div class="work-card__extra-inner">
                    <p class="eyebrow">
                      {categoryLabel(tool.category)} · v{tool.version}
                    </p>
                    <p class="work-card__summary">{tool.summary}</p>
                    <span class="work-card__link">
                      {tool.downloadUrl ? 'View & download →' : 'Details · Coming soon →'}
                    </span>
                  </div>
                </div>
                <h3 class="work-card__title">{tool.title}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-band__inner container reveal">
      <h2>Need a tool that is not listed?</h2>
      <a href="/contact" class="btn btn--solid" data-magnetic>Request a tool</a>
    </div>
  </section>
</BaseLayout>

<script>
  const labels: Record<string, string> = {
    apk: 'Android APK',
    ipa: 'iOS IPA',
    jailbreak: 'Jailbreak',
    exe: 'Windows EXE',
  };

  const heading = document.querySelector('[data-tools-heading]');
  const empty = document.querySelector('[data-tools-empty]') as HTMLElement | null;
  const cards = document.querySelectorAll('[data-tool-card]');
  const buttons = document.querySelectorAll('[data-filter]');

  function applyFilter(category: string) {
    let visible = 0;
    cards.forEach((card) => {
      const match = !category || card.getAttribute('data-category') === category;
      (card as HTMLElement).hidden = !match;
      if (match) visible += 1;
    });

    if (empty) empty.hidden = visible > 0;
    if (heading) {
      heading.textContent = category && labels[category] ? `${labels[category]}.` : 'All tools.';
    }

    buttons.forEach((btn) => {
      const active = btn.getAttribute('data-filter') === category;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    const url = new URL(window.location.href);
    if (category) url.searchParams.set('category', category);
    else url.searchParams.delete('category');
    window.history.replaceState({}, '', url.pathname + url.search);
  }

  const initial = new URLSearchParams(window.location.search).get('category') || '';
  applyFilter(initial);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      applyFilter(btn.getAttribute('data-filter') || '');
    });
  });
</script>

<style>
  .tools-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tools-filter {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    color: var(--fg-muted);
    background: transparent;
    cursor: pointer;
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      background 0.3s var(--ease-out);
  }

  .tools-filter:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .tools-filter.is-active {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }

  .tools-empty {
    color: var(--fg-muted);
    padding: 2rem 0;
  }

  .work-grid--page {
    grid-template-columns: repeat(3, 1fr);
  }

  .work-card--detail .work-card__meta {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    inset: 0;
    padding: 1.35rem 1.4rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.55) 38%,
      transparent 100%
    );
    transition: background 0.55s var(--ease-out);
  }

  .work-card--detail:hover .work-card__meta,
  .work-card--detail:focus-within .work-card__meta {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.98) 0%,
      rgba(0, 0, 0, 0.82) 52%,
      rgba(0, 0, 0, 0.35) 78%,
      transparent 100%
    );
  }

  .work-card__title {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .work-card__extra {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s var(--ease-out);
  }

  .work-card--detail:hover .work-card__extra,
  .work-card--detail:focus-within .work-card__extra {
    grid-template-rows: 1fr;
  }

  .work-card__extra-inner {
    overflow: hidden;
    min-height: 0;
  }

  .work-card__extra-inner .eyebrow {
    margin-bottom: 0.35rem;
    transform: translateY(1.25rem);
    opacity: 0;
    transition:
      transform 0.55s var(--ease-out),
      opacity 0.45s var(--ease-out);
  }

  .work-card__summary {
    margin: 0 0 0.75rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
    max-width: 36ch;
    line-height: 1.5;
    transform: translateY(1.25rem);
    opacity: 0;
    transition:
      transform 0.55s var(--ease-out) 0.06s,
      opacity 0.45s var(--ease-out) 0.06s;
  }

  .work-card__link {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--fg);
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      transform 0.55s var(--ease-out) 0.12s,
      opacity 0.45s var(--ease-out) 0.12s;
  }

  .work-card--detail:hover .work-card__extra-inner .eyebrow,
  .work-card--detail:hover .work-card__summary,
  .work-card--detail:hover .work-card__link,
  .work-card--detail:focus-within .work-card__extra-inner .eyebrow,
  .work-card--detail:focus-within .work-card__summary,
  .work-card--detail:focus-within .work-card__link {
    transform: translateY(0);
    opacity: 1;
  }

  .work-card--detail:hover .work-card__link,
  .work-card--detail:focus-within .work-card__link {
    opacity: 0.85;
  }

  @media (max-width: 1100px) {
    .work-grid--page {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .work-grid--page {
      grid-template-columns: 1fr;
    }

    .work-card--detail {
      aspect-ratio: 16 / 12;
    }

    .work-card--detail .work-card__meta {
      padding: 1.15rem 1.2rem;
    }

    .work-card__summary {
      font-size: 0.85rem;
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .work-card--detail {
      aspect-ratio: auto;
      min-height: 16rem;
    }

    .work-card--detail .work-card__meta {
      position: relative;
      inset: auto;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.92) 0%,
        rgba(0, 0, 0, 0.75) 70%,
        rgba(0, 0, 0, 0.45) 100%
      );
      padding-top: 3.5rem;
    }

    .work-card--detail .work-card__media {
      position: absolute;
      inset: 0;
    }
  }

  @media (hover: none) {
    .work-card--detail .work-card__extra {
      grid-template-rows: 1fr;
    }

    .work-card--detail .work-card__extra-inner .eyebrow,
    .work-card--detail .work-card__summary,
    .work-card--detail .work-card__link {
      transform: translateY(0);
      opacity: 1;
    }

    .work-card--detail .work-card__link {
      opacity: 0.85;
    }

    .work-card--detail .work-card__meta {
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.98) 0%,
        rgba(0, 0, 0, 0.82) 52%,
        rgba(0, 0, 0, 0.35) 78%,
        transparent 100%
      );
    }
  }

  @media (hover: none) and (max-width: 640px) {
    .work-card--detail .work-card__meta {
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.95) 0%,
        rgba(0, 0, 0, 0.8) 65%,
        rgba(0, 0, 0, 0.5) 100%
      );
    }
  }
</style>
