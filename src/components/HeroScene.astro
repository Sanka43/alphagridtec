---
---

<div class="hero-scene" data-hero-scene aria-hidden="true">
  <div class="hero-scene__perspective" data-hero-perspective>
    <div class="hero-scene__floor" data-hero-floor>
      <div class="hero-scene__floor-grid"></div>
    </div>

    <div class="hero-scene__objects" data-hero-objects>
      <div class="hero-cube" data-hero-cube>
        <div class="hero-cube__face hero-cube__face--front"></div>
        <div class="hero-cube__face hero-cube__face--back"></div>
        <div class="hero-cube__face hero-cube__face--right"></div>
        <div class="hero-cube__face hero-cube__face--left"></div>
        <div class="hero-cube__face hero-cube__face--top"></div>
        <div class="hero-cube__face hero-cube__face--bottom"></div>
      </div>

      <div class="hero-ring" data-hero-ring>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="hero-diamond" data-hero-diamond>
        <span></span>
        <span></span>
      </div>

      <div class="hero-node hero-node--a" data-hero-node></div>
      <div class="hero-node hero-node--b" data-hero-node></div>
      <div class="hero-node hero-node--c" data-hero-node></div>
    </div>
  </div>

  <div class="hero-scene__glow"></div>
  <div class="hero-scene__scanline"></div>
  <div class="hero-scene__vignette"></div>
</div>

<style>
  .hero-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 70% at 72% 40%, #121212 0%, #050505 55%, #000 100%);
  }

  .hero-scene__perspective {
    position: absolute;
    inset: 0;
    perspective: 1200px;
    perspective-origin: 72% 45%;
    transform-style: preserve-3d;
  }

  .hero-scene__floor {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(140vw, 1600px);
    height: min(140vw, 1600px);
    transform: translate(-50%, -50%) rotateX(78deg);
    transform-style: preserve-3d;
    opacity: 0.85;
  }

  .hero-scene__floor-grid {
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(rgba(245, 245, 245, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 245, 245, 0.14) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 65% at 50% 50%, #000 15%, transparent 72%);
    animation: heroGridDrift 24s linear infinite;
  }

  @keyframes heroGridDrift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 56px 56px, 56px 56px; }
  }

  .hero-scene__objects {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  /* Wireframe cube */
  .hero-cube {
    position: absolute;
    left: 72%;
    top: 38%;
    width: 140px;
    height: 140px;
    transform-style: preserve-3d;
    transform: translate3d(-50%, -50%, 120px) rotateX(-18deg) rotateY(28deg);
  }

  .hero-cube__face {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(245, 245, 245, 0.35);
    background: rgba(245, 245, 245, 0.03);
    box-shadow: inset 0 0 30px rgba(245, 245, 245, 0.04);
  }

  .hero-cube__face--front  { transform: translateZ(70px); }
  .hero-cube__face--back   { transform: rotateY(180deg) translateZ(70px); }
  .hero-cube__face--right  { transform: rotateY(90deg) translateZ(70px); }
  .hero-cube__face--left   { transform: rotateY(-90deg) translateZ(70px); }
  .hero-cube__face--top    { transform: rotateX(90deg) translateZ(70px); }
  .hero-cube__face--bottom { transform: rotateX(-90deg) translateZ(70px); }

  /* Orbital rings */
  .hero-ring {
    position: absolute;
    left: 72%;
    top: 38%;
    width: 280px;
    height: 280px;
    transform: translate3d(-50%, -50%, 40px);
    transform-style: preserve-3d;
  }

  .hero-ring span {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(245, 245, 245, 0.22);
    border-radius: 50%;
    transform-style: preserve-3d;
  }

  .hero-ring span:nth-child(1) { transform: rotateX(72deg); }
  .hero-ring span:nth-child(2) { transform: rotateY(72deg); }
  .hero-ring span:nth-child(3) { transform: rotateX(18deg) rotateY(42deg); }

  /* Brand diamond */
  .hero-diamond {
    position: absolute;
    left: 72%;
    top: 58%;
    width: 88px;
    height: 88px;
    transform: translate3d(-50%, -50%, 180px) rotateX(55deg) rotateZ(45deg);
    transform-style: preserve-3d;
  }

  .hero-diamond span {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(245, 245, 245, 0.45);
    background: linear-gradient(135deg, rgba(245, 245, 245, 0.12), transparent);
    transform-style: preserve-3d;
  }

  .hero-diamond span:last-child {
    transform: translateZ(36px);
    opacity: 0.55;
  }

  /* Floating nodes */
  .hero-node {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--fg);
    box-shadow: 0 0 18px rgba(245, 245, 245, 0.55);
    transform-style: preserve-3d;
  }

  .hero-node--a {
    left: 48%;
    top: 28%;
    transform: translate3d(-50%, -50%, 200px);
  }

  .hero-node--b {
    left: 78%;
    top: 22%;
    transform: translate3d(-50%, -50%, 90px);
  }

  .hero-node--c {
    left: 55%;
    top: 62%;
    transform: translate3d(-50%, -50%, 60px);
  }

  .hero-scene__glow {
    position: absolute;
    width: min(50vw, 480px);
    height: min(50vw, 480px);
    right: 10%;
    top: 18%;
    background: radial-gradient(circle, rgba(245, 245, 245, 0.08) 0%, transparent 68%);
    pointer-events: none;
  }

  .hero-scene__scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(245, 245, 245, 0.015) 2px,
      rgba(245, 245, 245, 0.015) 4px
    );
    pointer-events: none;
    opacity: 0.35;
  }

  .hero-scene__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.25) 42%, transparent 68%),
      radial-gradient(ellipse 80% 60% at 20% 80%, transparent 20%, rgba(0, 0, 0, 0.55) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, transparent 35%, rgba(0, 0, 0, 0.35) 100%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-scene {
      background: radial-gradient(ellipse 90% 60% at 50% 28%, #121212 0%, #050505 55%, #000 100%);
    }

    .hero-scene__perspective {
      perspective-origin: 50% 32%;
    }

    .hero-cube {
      left: 78%;
      top: 22%;
      width: 88px;
      height: 88px;
      transform: translate3d(-50%, -50%, 60px) rotateX(-14deg) rotateY(22deg);
      opacity: 0.7;
    }

    .hero-cube__face--front  { transform: translateZ(44px); }
    .hero-cube__face--back   { transform: rotateY(180deg) translateZ(44px); }
    .hero-cube__face--right  { transform: rotateY(90deg) translateZ(44px); }
    .hero-cube__face--left   { transform: rotateY(-90deg) translateZ(44px); }
    .hero-cube__face--top    { transform: rotateX(90deg) translateZ(44px); }
    .hero-cube__face--bottom { transform: rotateX(-90deg) translateZ(44px); }

    .hero-ring {
      width: 170px;
      height: 170px;
      left: 78%;
      top: 22%;
      opacity: 0.65;
    }

    .hero-diamond {
      left: 82%;
      top: 42%;
      width: 52px;
      height: 52px;
      opacity: 0.7;
    }

    .hero-node--a {
      left: 18%;
      top: 18%;
    }

    .hero-node--b {
      left: 88%;
      top: 14%;
    }

    .hero-node--c {
      display: none;
    }

    .hero-scene__glow {
      right: 5%;
      top: 8%;
      width: min(70vw, 320px);
      height: min(70vw, 320px);
      opacity: 0.7;
    }

    .hero-scene__vignette {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, transparent 28%, rgba(0, 0, 0, 0.55) 100%),
        linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.2) 55%, transparent 85%);
    }

    .hero-scene__floor {
      top: 62%;
      opacity: 0.55;
    }
  }

  @media (max-width: 640px) {
    .hero-cube,
    .hero-ring {
      left: 85%;
    }

    .hero-diamond {
      left: 88%;
      top: 38%;
    }

    .hero-scene__scanline {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scene__floor-grid {
      animation: none;
    }
  }
</style>
